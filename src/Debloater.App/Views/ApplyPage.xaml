<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Debloater.App.Views.ApplyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,12,24,24" Spacing="8" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock x:Uid="ApplyPage_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />

            <StackPanel x:Name="EmptyPanel" Spacing="8" Visibility="Collapsed" Margin="0,16">
                <TextBlock x:Uid="ApplyPage_EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="ApplyPage_EmptyText" Style="{StaticResource Caption}" />
                <Button x:Uid="ApplyPage_GoTweaks" Click="GoTweaks_Click" />
            </StackPanel>

            <StackPanel x:Name="Groups" Spacing="12" />

            <StackPanel x:Name="OptionsPanel" Spacing="8" Margin="0,8,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <ToggleSwitch x:Name="RestorePointToggle" x:Uid="ApplyPage_RestorePointToggle" Toggled="RestorePoint_Toggled" />
                        <TextBlock x:Uid="ApplyPage_RestorePointText" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <CheckBox x:Name="HighConfirm" x:Uid="ApplyPage_HighConfirm" Visibility="Collapsed" Checked="Confirm_Changed" Unchecked="Confirm_Changed" />
                <TextBlock x:Name="CriticalNote" x:Uid="ApplyPage_CriticalNote" Visibility="Collapsed" Style="{StaticResource Caption}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <InfoBar x:Name="ElevationBar" x:Uid="ApplyPage_ElevationBar" Severity="Warning" IsClosable="False" IsOpen="False" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock x:Name="ApplyText" /></StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" x:Uid="ApplyPage_CancelButton" Click="Cancel_Click" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="RunPanel" Spacing="8" Visibility="Collapsed" Margin="0,16,0,0">
                <TextBlock x:Uid="ApplyPage_Progress" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ProgressBar x:Name="RunProgress" />
                <TextBlock x:Name="RunText" Style="{StaticResource Caption}" />
                <StackPanel x:Name="Results" Spacing="4" />
                <Grid>
                    <TextBlock x:Uid="ApplyPage_Log" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Bottom" />
                    <Button x:Uid="Common_OpenLogsButton" HorizontalAlignment="Right" Click="OpenLogs_Click" />
                </Grid>
                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"
                         FontSize="12" MinHeight="160" MaxHeight="360" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
