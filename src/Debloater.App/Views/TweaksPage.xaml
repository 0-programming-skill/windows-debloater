<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Debloater.App.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Debloater.App.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="ActionTemplate" x:DataType="vm:ActionItemViewModel">
            <Grid ColumnSpacing="12" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="10" Height="10" Fill="{x:Bind StateBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" Text="{x:Bind TypeText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{x:Bind Desired}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisibility}" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{x:Bind StateText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LinkTemplate" x:DataType="vm:LinkItem">
            <Grid>
                <HyperlinkButton Content="{x:Bind Text}" NavigateUri="{x:Bind Uri}" Visibility="{x:Bind IsLink}" Padding="4,2" />
                <TextBlock Text="{x:Bind Text}" Visibility="{x:Bind IsText}" Style="{StaticResource Caption}" Margin="4,4" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TweakTemplate" x:DataType="vm:TweakItemViewModel">
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                <Expander.Header>
                    <Grid ColumnSpacing="12" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind DesiredChecked, Mode=OneWay}" Click="Desired_Click" Tag="{x:Bind Id}" IsEnabled="{x:Bind CanChoose, Mode=OneWay}"
                                  MinWidth="0" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Estado desejado: marcado = aplicado, desmarcado = não aplicado" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind PendingText, Mode=OneWay}" Visibility="{x:Bind PendingVisibility, Mode=OneWay}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ShortDescription}" Style="{StaticResource Caption}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Style="{StaticResource BadgeBorder}" Background="{x:Bind StateBrush, Mode=OneWay}" MinWidth="96"
                                    ToolTipService.ToolTip="Estado atual neste PC">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{x:Bind StateText, Mode=OneWay}" Foreground="{x:Bind StateForeground, Mode=OneWay}" />
                            </Border>
                            <Border Style="{StaticResource BadgeBorder}" Background="{x:Bind RiskBrush}" ToolTipService.ToolTip="{x:Bind RiskTip}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{x:Bind RiskText}" Foreground="{x:Bind RiskForeground}" />
                            </Border>
                            <Border Style="{StaticResource BadgeBorder}" BorderBrush="{x:Bind ConfidenceBrush}" BorderThickness="1.5" MinWidth="88"
                                    ToolTipService.ToolTip="{x:Bind ConfidenceTip}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{x:Bind ConfidenceText}" Foreground="{x:Bind ConfidenceBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Expander.Header>

                <StackPanel Spacing="8" Padding="40,0,0,0">
                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Title="O que pode quebrar"
                             Message="{x:Bind Breaks}" Visibility="{x:Bind BreaksVisibility}" />
                    <TextBlock Text="{x:Bind StateMessage, Mode=OneWay}" Visibility="{x:Bind StateMessageVisibility, Mode=OneWay}" Style="{StaticResource Caption}" />

                    <TextBlock Text="Ações e estado de cada uma" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{x:Bind Actions, Mode=OneWay}" ItemTemplate="{StaticResource ActionTemplate}" />

                    <StackPanel Visibility="{x:Bind LinksVisibility}" Spacing="2">
                        <TextBlock Text="Fontes e referências" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <ItemsControl ItemsSource="{x:Bind Links}" ItemTemplate="{StaticResource LinkTemplate}" />
                    </StackPanel>

                    <StackPanel Spacing="2" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="Id: " /><Run Text="{x:Bind Id}" FontFamily="{StaticResource MonoFont}" />
                            <Run Text="  ·  " /><Run Text="{x:Bind BuildText}" />
                            <Run Text="  ·  " /><Run Text="{x:Bind Category}" />
                        </TextBlock>
                        <TextBlock Text="{x:Bind ReversibleText}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{x:Bind ConfidenceTip}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{x:Bind TagsText}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{x:Bind SourceFileText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,12,24,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Ajustes" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ClearButton" Click="Clear_Click" ToolTipService.ToolTip="Descarta todas as escolhas (nada pendente)">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE894;" FontSize="14" /><TextBlock Text="Limpar seleção" /></StackPanel>
                </Button>
                <Button x:Name="ReviewButton" Style="{StaticResource AccentButtonStyle}" Click="Review_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE73E;" FontSize="14" /><TextBlock x:Name="ReviewText" Text="Revisar mudanças" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Buscar por nome, descrição, id ou tag" QueryIcon="Find"
                            TextChanged="Search_TextChanged" />
            <DropDownButton x:Name="StateFilterButton" Grid.Column="1" Content="Estado">
                <DropDownButton.Flyout><MenuFlyout x:Name="StateMenu" Placement="Bottom" /></DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton x:Name="RiskFilterButton" Grid.Column="2" Content="Risco">
                <DropDownButton.Flyout><MenuFlyout x:Name="RiskMenu" Placement="Bottom" /></DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton x:Name="ConfidenceFilterButton" Grid.Column="3" Content="Confiança">
                <DropDownButton.Flyout><MenuFlyout x:Name="ConfidenceMenu" Placement="Bottom" /></DropDownButton.Flyout>
            </DropDownButton>
            <ToggleButton x:Name="DiffToggle" Grid.Column="4" Content="Só o que difere do desejado" Click="Filter_Changed" />
            <Button Grid.Column="6" Click="Refresh_Click" ToolTipService.ToolTip="Ler de novo o estado de todos os ajustes">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Atualizar" /></StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="2" x:Name="ScanPanel" Spacing="4">
            <ProgressBar x:Name="ScanProgress" />
            <TextBlock x:Name="ScanText" Style="{StaticResource Caption}" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" Padding="0,0,12,24">
            <StackPanel>
                <ItemsRepeater x:Name="List" ItemTemplate="{StaticResource TweakTemplate}" />
                <TextBlock x:Name="EmptyText" Text="Nenhum ajuste corresponde aos filtros." Style="{StaticResource Caption}"
                           Visibility="Collapsed" Margin="0,24" HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
