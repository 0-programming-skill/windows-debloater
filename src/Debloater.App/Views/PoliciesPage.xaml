<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Debloater.App.Views.PoliciesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Debloater.App.ViewModels">

    <Grid Padding="24,12,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Políticas (ADMX)" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}"
                       Text="Todas as Políticas de Grupo dos modelos administrativos deste PC, com o estado atual. Somente leitura nesta versão." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="460" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Buscar política, chave ou valor do registro" QueryIcon="Find" TextChanged="Search_TextChanged" />
            <ToggleButton x:Name="ConfiguredToggle" Grid.Column="1" Content="Só configuradas" Click="Filter_Changed" />
            <TextBlock x:Name="CountText" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0" />
            <Button Grid.Column="3" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Atualizar" /></StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="200" MaxWidth="320" />
                <ColumnDefinition Width="3*" MinWidth="280" />
                <ColumnDefinition Width="3*" MinWidth="280" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="4">
                <TreeView x:Name="Tree" SelectionMode="Single" ItemInvoked="Tree_ItemInvoked" />
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListView x:Name="List" SelectionMode="Single" SelectionChanged="List_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PolicyItem">
                                <Grid ColumnSpacing="8" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind CategoryText}" Style="{StaticResource Caption}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeBorder}" Background="{x:Bind StateBrush}" MinWidth="110">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="{x:Bind StateText}" Foreground="{x:Bind StateForeground}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <ProgressRing IsActive="True" />
                        <TextBlock Text="Lendo os modelos administrativos e o registro..." Style="{StaticResource Caption}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer>
                    <StackPanel x:Name="Details" Spacing="6" Visibility="Collapsed">
                        <TextBlock x:Name="DName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Border x:Name="DStateBadge" Style="{StaticResource BadgeBorder}" HorizontalAlignment="Left">
                            <TextBlock x:Name="DState" Style="{StaticResource BadgeText}" />
                        </Border>
                        <TextBlock Text="Estado por escopo" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="DScopes" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="Registro" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="DRegistry" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="Detalhes" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="DMeta" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                        <HyperlinkButton x:Name="DCsp" Padding="0,4" />
                        <TextBlock Text="Explicação" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="DExplain" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
