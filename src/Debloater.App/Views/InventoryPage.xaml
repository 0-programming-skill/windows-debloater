<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Debloater.App.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Debloater.App.ViewModels">

    <Grid Padding="24,12,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Inventário" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Tudo o que existe neste PC, de cada tipo, e quais ajustes do catálogo mexem em cada item. Itens não catalogados são candidatos a ajustes novos." />
        </StackPanel>

        <SelectorBar x:Name="Kinds" Grid.Row="1" SelectionChanged="Kinds_SelectionChanged" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="460" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Buscar por nome ou propriedade" QueryIcon="Find" TextChanged="Search_TextChanged" />
            <ToggleButton x:Name="UncataloguedToggle" Grid.Column="1" Content="Só não catalogados" Click="Filter_Changed" />
            <TextBlock x:Name="CountText" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap" />
            <Button Grid.Column="3" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Atualizar" /></StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <ListView x:Name="List" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:InventoryRow">
                            <Grid ColumnSpacing="12" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind PropertiesText}" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind TweaksText}" Visibility="{x:Bind IsCatalogued}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource BadgeBorder}" Background="{x:Bind BadgeBrush}" MinWidth="110">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{x:Bind BadgeText}" Foreground="{x:Bind BadgeForeground}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressRing IsActive="True" />
                    <TextBlock Text="Enumerando serviços, drivers, tarefas, apps, recursos, capacidades e autoruns..." Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
