<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Debloater.App.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,12,24,24" Spacing="8" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock x:Uid="ProfilesPage_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="ProfilesPage_Subtitle" Style="{StaticResource Caption}" />

            <InfoBar x:Name="Info" IsOpen="False" />

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="ProfilesPage_SaveHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="ProfilesPage_SaveText" Style="{StaticResource Caption}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox" x:Uid="ProfilesPage_NameBox" />
                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="Save_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="14" /><TextBlock x:Uid="ProfilesPage_SaveText2" /></StackPanel>
                        </Button>
                    </Grid>
                    <TextBox x:Name="DescriptionBox" x:Uid="ProfilesPage_DescriptionBox" />
                </StackPanel>
            </Border>

            <Grid Margin="0,8,0,0">
                <TextBlock x:Uid="ProfilesPage_Available" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Click="Import_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B5;" FontSize="14" /><TextBlock x:Uid="ProfilesPage_ImportText" /></StackPanel>
                    </Button>
                    <Button x:Uid="ProfilesPage_OpenFolder" Click="OpenFolder_Click" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="ProfileList" Spacing="8" />
        </StackPanel>
    </ScrollViewer>
</Page>
