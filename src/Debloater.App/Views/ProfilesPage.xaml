<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Debloater.App.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,12,24,24" Spacing="8" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Perfis" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Um perfil é uma seleção de estados desejados (arquivo YAML). Carregar um perfil substitui a seleção atual; nada é aplicado sem passar pela revisão." />

            <InfoBar x:Name="Info" IsOpen="False" />

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Salvar a seleção atual" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Grava como perfil o estado desejado de cada ajuste: suas escolhas explícitas e o que já está aplicado neste PC." />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox" PlaceholderText="Nome do perfil (ex.: Meu notebook)" />
                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="Save_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="14" /><TextBlock Text="Salvar" /></StackPanel>
                        </Button>
                    </Grid>
                    <TextBox x:Name="DescriptionBox" PlaceholderText="Descrição (opcional)" />
                </StackPanel>
            </Border>

            <Grid Margin="0,8,0,0">
                <TextBlock Text="Perfis disponíveis" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Click="Import_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B5;" FontSize="14" /><TextBlock Text="Importar..." /></StackPanel>
                    </Button>
                    <Button Click="OpenFolder_Click" Content="Abrir pasta dos perfis" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="ProfileList" Spacing="8" />
        </StackPanel>
    </ScrollViewer>
</Page>
