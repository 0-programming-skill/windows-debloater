<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Debloater.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,12,24,24" Spacing="12" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock x:Uid="OverviewPage_Title" Style="{StaticResource TitleTextBlockStyle}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F8;" FontSize="16" />
                            <TextBlock x:Uid="OverviewPage_ThisPc" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="ProductText" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="BuildText" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="EditionText" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ElevationIcon" FontSize="16" />
                            <TextBlock x:Uid="OverviewPage_Permissions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="ElevationTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ElevationText" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Uid="OverviewPage_ByState" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <ProgressRing x:Name="ScanRing" Width="16" Height="16" IsActive="False" />
                    <TextBlock x:Name="ScanText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Button Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock x:Uid="Common_RefreshText" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <VariableSizedWrapGrid x:Name="StateTiles" Orientation="Horizontal" ItemWidth="200" ItemHeight="96" />

            <TextBlock x:Uid="OverviewPage_ByRisk" Style="{StaticResource SectionTitle}" />
            <VariableSizedWrapGrid x:Name="RiskTiles" Orientation="Horizontal" ItemWidth="200" ItemHeight="96" />

            <TextBlock x:Uid="OverviewPage_QuickProfiles" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Uid="OverviewPage_QuickProfilesText" Style="{StaticResource Caption}" />
            <StackPanel x:Name="ProfileButtons" Orientation="Horizontal" Spacing="8" />
            <InfoBar x:Name="ProfileInfo" IsOpen="False" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
