<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Debloater.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,12,24,24" Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Configurações" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="Info" IsOpen="False" />

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Pasta do catálogo" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Pasta com os arquivos YAML dos ajustes (e a subpasta profiles com os perfis embutidos)." />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CatalogBox" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Procurar..." Click="BrowseCatalog_Click" />
                        <Button Grid.Column="2" Content="Padrão" Click="DefaultCatalog_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Pasta dos backups" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Onde fica o valor original de cada ajuste aplicado (necessário para reverter). Mudar a pasta não move backups existentes." />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackupBox" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Procurar..." Click="BrowseBackup_Click" />
                        <Button Grid.Column="2" Content="Padrão" Click="DefaultBackup_Click" />
                        <Button Grid.Column="3" Content="Abrir" Click="OpenBackup_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Aparência e idioma" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <RadioButtons x:Name="ThemeRadios" Header="Tema" SelectionChanged="Theme_Changed">
                        <x:String>Usar o tema do sistema</x:String>
                        <x:String>Claro</x:String>
                        <x:String>Escuro</x:String>
                    </RadioButtons>
                    <ComboBox Header="Idioma" SelectedIndex="0" IsEnabled="False" MinWidth="240">
                        <x:String>Português (Brasil)</x:String>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Caption}" Text="Por enquanto só há português (Brasil)." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Logs" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="LogsText" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                    <Button Content="Abrir pasta de logs" Click="OpenLogs_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Sobre" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
