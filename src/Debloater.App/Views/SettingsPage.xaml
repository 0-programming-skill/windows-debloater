<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Debloater.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,12,24,24" Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock x:Uid="SettingsPage_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="Info" IsOpen="False" />

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsPage_CatalogHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsPage_CatalogText" Style="{StaticResource Caption}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CatalogBox" IsReadOnly="True" />
                        <Button x:Uid="SettingsPage_Browse" Grid.Column="1" Click="BrowseCatalog_Click" />
                        <Button x:Uid="SettingsPage_Default" Grid.Column="2" Click="DefaultCatalog_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsPage_UpdatesHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsPage_UpdatesText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <TextBlock x:Name="CatalogVersionText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock x:Name="CatalogDetailsText" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="AutoUpdateToggle" x:Uid="SettingsPage_AutoUpdateToggle" Toggled="AutoUpdate_Toggled" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckNowButton" x:Uid="SettingsPage_CheckNow" Click="CheckNow_Click" />
                        <Button x:Name="RollbackButton" x:Uid="SettingsPage_RollbackBuiltIn" Click="RollbackBuiltIn_Click" />
                        <ProgressRing x:Name="CheckProgress" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsPage_BackupHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsPage_BackupText" Style="{StaticResource Caption}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackupBox" IsReadOnly="True" />
                        <Button x:Uid="SettingsPage_Browse" Grid.Column="1" Click="BrowseBackup_Click" />
                        <Button x:Uid="SettingsPage_Default" Grid.Column="2" Click="DefaultBackup_Click" />
                        <Button x:Uid="SettingsPage_Open" Grid.Column="3" Click="OpenBackup_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsPage_AppearanceHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <RadioButtons x:Name="ThemeRadios" x:Uid="SettingsPage_ThemeRadios" SelectionChanged="Theme_Changed" />
                    <ComboBox x:Name="LanguageBox" x:Uid="SettingsPage_LanguageBox" MinWidth="240" SelectionChanged="Language_Changed" />
                    <TextBlock x:Uid="SettingsPage_LanguageText" Style="{StaticResource Caption}" />
                    <InfoBar x:Name="RestartBar" x:Uid="SettingsPage_RestartBar" Severity="Informational" IsClosable="False" IsOpen="False">
                        <InfoBar.ActionButton>
                            <Button x:Uid="SettingsPage_RestartButton" Click="Restart_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsPage_LogsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="LogsText" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                    <Button x:Uid="Common_OpenLogsButton" Click="OpenLogs_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsPage_AboutHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
